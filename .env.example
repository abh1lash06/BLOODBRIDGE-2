# BloodBridge Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the .env file.

# Database Configuration
# Local MySQL example:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bloodbridge_app?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=abhilash@123
#
# Production PostgreSQL example (Railway):
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE_NAME
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_FLYWAY_LOCATIONS=classpath:db/migration/postgresql

# JWT Secret - Use a strong Base64-encoded key (at least 256 bits / 32 bytes)
# Generate with: openssl rand -base64 64
APP_JWT_SECRET=your_base64_encoded_secret_key

# CORS - Comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Server Port (Railway provides this automatically)
PORT=8080
